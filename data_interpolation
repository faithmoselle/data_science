import numpy as np
import matplotlib.pyplot as plt
from scipy.interpolate import interp1d

print("=" * 60)
print("LAB 6: DATA INTERPOLATION - COMMUTE TIME ANALYSIS")
print("=" * 60)

# ============================================================================
# 1. DATA ENTRY: Observed commute times
# ============================================================================
# departure: minutes after 6:00 AM
departure = np.array([0, 15, 30, 45, 60, 90])        # 6:00, 6:15, 6:30, 6:45, 7:00, 7:30
travel_time = np.array([25, 22, 28, 35, 50, 42])     # commute duration in minutes

print("\n--- OBSERVED DATA ---")
print(f"Departure times (min after 6:00): {departure}")
print(f"Travel times (minutes): {travel_time}")

# ============================================================================
# 2. MANUAL LINEAR INTERPOLATION (From Scratch)
# ============================================================================
def linear_interpolate(x, x1, y1, x2, y2):
    """
    Perform linear interpolation between two points (x1, y1) and (x2, y2).
    
    Formula: y = y1 + (y2 - y1) * (x - x1) / (x2 - x1)
    
    Args:
        x: Query point (value to predict at)
        x1, y1: First known point
        x2, y2: Second known point
    
    Returns:
        Interpolated y value at x
    """
    return y1 + (y2 - y1) * (x - x1) / (x2 - x1)

# Estimate travel time at 6:10 AM (x = 10)
# Using surrounding points: (0, 25) and (15, 22)
est_10 = linear_interpolate(10, 0, 25, 15, 22)

# Estimate travel time at 7:05 AM (x = 65)
# Using surrounding points: (60, 50) and (90, 42)
est_65 = linear_interpolate(65, 60, 50, 90, 42)

print("\n--- MANUAL LINEAR INTERPOLATION RESULTS ---")
print(f"Travel Time at 6:10 AM (x = 10 min): {est_10:.2f} minutes")
print(f"Travel Time at 7:05 AM (x = 65 min): {est_65:.2f} minutes")

# ============================================================================
# 3. USING SCIPY'S BUILT-IN INTERPOLATION
# ============================================================================
# Create interpolation function (default: linear)
f = interp1d(departure, travel_time)

# Query points of interest
query_times = np.array([10, 25, 40, 65])  # 6:10, 6:25, 6:40, 7:05
predicted = f(query_times)

print("\n--- SCIPY INTERPOLATION RESULTS ---")
for qt, pred in zip(query_times, predicted):
    # Convert minutes to readable time format
    hours = 6 + qt // 60
    mins = qt % 60
    print(f"At {hours:02d}:{mins:02d} (x = {qt:2d} min) -> {pred:.2f} minutes travel time")

# ============================================================================
# 4. DATA VISUALIZATION
# ============================================================================
plt.figure(figsize=(10, 6))
plt.scatter(departure, travel_time, color='red', s=80, label='Observed Data')
plt.plot(departure, travel_time, 'r--', alpha=0.5, label='Connection Line')
plt.scatter(query_times, predicted, color='blue', s=80, label='Interpolated Predictions')
plt.xlabel('Departure Time (minutes after 6:00 AM)', fontsize=12)
plt.ylabel('Travel Time (minutes)', fontsize=12)
plt.title('Commute Time vs Departure Time (Linear Interpolation)', fontsize=14)
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.show()

# ============================================================================
# 5. EXTRAPOLATION (LIMITATIONS)
# ============================================================================
print("\n--- EXTRAPOLATION (Outside Data Range) ---")
print("⚠️  WARNING: Extrapolation can produce unrealistic results ⚠️")

# Create extrapolation function (allows predictions outside data range)
f_extrap = interp1d(departure, travel_time, fill_value='extrapolate')

pred_before = f_extrap(-5)   # 5 minutes before 6:00 AM (5:55)
pred_after = f_extrap(120)   # 8:00 AM

print(f"Prediction at 5:55 AM (x = -5 min): {pred_before:.2f} minutes")
print(f"Prediction at 8:00 AM (x = 120 min): {pred_after:.2f} minutes")
print("Observation: Extrapolated values may be nonsensical (e.g., negative time or unrealistic estimates).")

# ============================================================================
# 6. ERROR ANALYSIS
# ============================================================================
print("\n--- ERROR ANALYSIS ---")

# Suppose actual travel time at 6:40 AM is known to be 33 minutes
actual_640 = 33  # actual observed value at 6:40
predicted_640 = f(40)  # interpolated prediction at x=40

absolute_error = abs(predicted_640 - actual_640)
percent_error = (absolute_error / actual_640) * 100

print(f"Actual travel time at 6:40 AM: {actual_640} minutes")
print(f"Predicted travel time at 6:40 AM: {predicted_640:.2f} minutes")
print(f"Absolute Error: {absolute_error:.2f} minutes")
print(f"Percent Error: {percent_error:.2f}%")

# ============================================================================
# SUMMARY OF FINDINGS
# ============================================================================
print("\n" + "=" * 60)
print("KEY INSIGHTS")
print("=" * 60)
print("""
1. INTERPOLATION: Estimates values within the data range using surrounding points.
   - Linear interpolation assumes a straight line between known points.
   
2. EXTRAPOLATION: Predicts outside the data range - often unreliable.
   - The model has no information about behavior beyond observed limits.
   
3. ERROR ANALYSIS: Helps quantify prediction accuracy.
   - Smaller error indicates better model fit.
   
